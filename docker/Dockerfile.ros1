# ROS1 Noetic environment for the mapping experiments (amd64 and arm64).
# Build:  docker/build.sh ros1 noetic        (or: make image-ros1)
# Run:    docker run -it --rm -v "$PWD":/work -w /work ros1-mapping:noetic ./experiments/run_ros1.sh
# BASE_IMAGE is pinned by digest from docker/base-images.lock when that file exists.
ARG BASE_IMAGE=ros:noetic
FROM ${BASE_IMAGE}
ARG BASE_IMAGE
LABEL org.opencontainers.image.source="https://github.com/ATemova/ros1-ros2-mapping-comparison" \
      org.opencontainers.image.description="ROS1 Noetic environment for ros1-ros2-mapping-comparison" \
      org.opencontainers.image.licenses="MIT" \
      io.github.atemova.base-image="${BASE_IMAGE}"

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3-psutil \
      python3-numpy \
      python3-yaml \
      python3-pandas \
      python3-matplotlib \
      ros-noetic-map-server \
      ros-noetic-slam-toolbox \
      ros-noetic-slam-gmapping \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /work
CMD ["bash"]
